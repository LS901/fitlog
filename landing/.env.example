# Where the waitlist form POSTs (JSON). A Formspree form endpoint works as-is:
# create a form at https://formspree.io and paste its URL, e.g. https://formspree.io/f/abcdwxyz
NEXT_PUBLIC_WAITLIST_ENDPOINT=

