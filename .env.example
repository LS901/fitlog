# Create an app at https://developer.withings.com/ (free for personal use)
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
# Must exactly match the callback URL registered in your Withings app, e.g.
# http://localhost:3000/api/withings/callback  (or your deployed https URL)
WITHINGS_REDIRECT_URI=http://localhost:3000/api/withings/callback

# Phase generator (/workouts/plan). Both are required, otherwise generation is disabled.
# API key from https://console.anthropic.com/ (billed per use; roughly 10-20p per generated phase)
ANTHROPIC_API_KEY=
# Any passphrase you choose. The app asks for it once per device, so strangers who find
# your URL can't spend your API credit.
FITLOG_ACCESS_CODE=
